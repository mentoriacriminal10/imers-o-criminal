    .month-body { grid-template-columns: 1fr; }
    .half:first-child { border-right: none; border-bottom: 0.5px solid #2e2c2a; }
    .del-grid { grid-template-columns: 1fr; }
  }

  @media print {
    body { background: #0f0e0d; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
</head>
