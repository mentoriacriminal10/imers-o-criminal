<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'DM Sans', sans-serif; background: #0f0e0d; color: #F1EFE8; min-height: 100vh; padding: 2rem 1rem; }
  .page { max-width: 760px; margin: 0 auto; }

  .hero { border: 0.5px solid #3a3835; border-radius: 14px; padding: 2.5rem 2rem 2rem; margin-bottom: 1.5rem; }
  .eyebrow { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #888780; margin-bottom: 1rem; font-weight: 500; }
  .hero-title { font-family: 'Playfair Display', serif; font-size: 42px; font-weight: 900; line-height: 1.1; margin-bottom: 1rem; color: #F1EFE8; }
  .hero-title span { font-style: italic; color: #D85A30; }
  .hero-line { width: 40px; height: 2px; background: #D85A30; border-radius: 2px; margin-bottom: 1rem; }
  .hero-sub { font-size: 15px; line-height: 1.7; color: #B4B2A9; max-width: 520px; }
  .hero-tag { display: inline-flex; align-items: center; gap: 6px; background: rgba(216,90,48,0.12); border: 0.5px solid rgba(216,90,48,0.4); border-radius: 20px; padding: 5px 14px; font-size: 12px; color: #F0997B; font-weight: 500; margin-top: 1.25rem; }

