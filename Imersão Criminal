  .months { display: flex; flex-direction: column; gap: 12px; margin-bottom: 1.5rem; }
  .month-card { background: #141312; border: 0.5px solid #2e2c2a; border-radius: 14px; overflow: hidden; }
  .month-head { display: flex; align-items: center; gap: 14px; padding: 1rem 1.25rem; border-bottom: 0.5px solid #2e2c2a; }
