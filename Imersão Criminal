  .month-body { display: grid; grid-template-columns: 1fr 1fr; }
  .half { padding: 1rem 1.25rem; }
  .half:first-child { border-right: 0.5px solid #2e2c2a; }
  .half-lbl { font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: #5F5E5A; font-weight: 500; margin-bottom: 10px; }
  .half ul { list-style: none; }
  .half ul li { font-size: 12px; color: #888780; padding: 4px 0; display: flex; align-items: flex-start; gap: 8px; line-height: 1.5; }
  .half ul li::before { content: '—'; color: #D85A30; font-size: 11px; flex-shrink: 0; margin-top: 1px; }

  .law-strip { display: flex; flex-wrap: wrap; gap: 8px; padding: 0.75rem 1.25rem; background: #1a1917; border-top: 0.5px solid #2e2c2a; }
  .law-pill { display: inline-flex; align-items: center; gap: 5px; background: #141312; border: 0.5px solid #3a3835; border-radius: 20px; padding: 3px 10px; font-size: 11px; color: #888780; }
  .law-dot { width: 5px; height: 5px; border-radius: 50%; background: #D85A30; flex-shrink: 0; }

  .del-box { border: 0.5px solid #2e2c2a; border-radius: 14px; padding: 1.5rem; margin-bottom: 1.5rem; background: #141312; }
  .del-title { font-size: 15px; font-weight: 500; color: #F1EFE8; margin-bottom: 1rem; }
  .del-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .del-item { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #888780; }
  .del-dot { width: 6px; height: 6px; border-radius: 50%; background: #D85A30; flex-shrink: 0; }

  .quote-block { border-left: 2px solid #D85A30; padding: 1rem 1.5rem; margin-bottom: 1.5rem; }
  .quote-text { font-family: 'Playfair Display', serif; font-size: 17px; font-style: italic; line-height: 1.6; color: #D3D1C7; margin-bottom: 6px; }
  .quote-attr { font-size: 12px; color: #5F5E5A; }

  .cta-block { background: #1a1917; border: 0.5px solid #3a3835; border-radius: 14px; padding: 2rem; text-align: center; }
  .cta-title { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: #F1EFE8; margin-bottom: 6px; }
